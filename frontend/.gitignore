# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The root .gitignore has a Python "lib/" rule (for build artifacts) that
# unintentionally matches this frontend's src/lib SOURCE folder and silently
# drops files from it (this is why soundEffects.js was missing on main).
# Keep the frontend source lib tracked.
!src/lib/
!src/lib/**

# Vite cache
.vite/
